# Database (Neon Postgres - EU Frankfurt)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Upstash Redis (EU)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Better Auth
BETTER_AUTH_SECRET=generate-a-random-32-char-hex-string
# Must be the exact base URL clients use. For a physical phone use your PC LAN URL (same host as EXPO_PUBLIC_API_URL), not localhost.
BETTER_AUTH_URL=http://localhost:3000

# Expo (mobile)
# Simulator: localhost is fine. Physical device: use your PC/Mac LAN IP, e.g. http://192.168.1.10:3000
# (Must match where the API server runs. Set BETTER_AUTH_URL to the same origin for sign-in.)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Qdrant (optional - KB features disabled without this)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3001

# Logging
LOG_LEVEL=info
