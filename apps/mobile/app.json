{
  "expo": {
    "name": "Aucta",
    "slug": "aucta",
    "version": "0.1.0",
    "scheme": "aucta",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aucta.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "Aucta uses the microphone for voice communication during AI-assisted HVAC sessions",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.aucta.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["RECORD_AUDIO", "FOREGROUND_SERVICE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "Allow Aucta to use the camera for AI-assisted HVAC sessions and QR code scanning"
      }]
    ]
  }
}
