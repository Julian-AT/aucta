{
  "expo": {
    "name": "Aucta",
    "slug": "aucta",
    "version": "0.1.0",
    "scheme": "aucta",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aucta.app"
    },
    "android": {
      "package": "com.aucta.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow Aucta to scan QR codes for invite codes" }]
    ]
  }
}
